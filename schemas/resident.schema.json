{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resident.schema.json",
  "title": "WORLD_SEED Resident Definition",
  "description": "Draft starting definition for one resident.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resident_version",
    "id",
    "display_name",
    "summary",
    "starting_location",
    "policy",
    "capabilities",
    "permissions",
    "memory"
  ],
  "properties": {
    "resident_version": {
      "const": "0.1-draft"
    },
    "id": {
      "$ref": "#/$defs/namespaced_id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "starting_location": {
      "$ref": "#/$defs/namespaced_id"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "adapter", "profile"],
      "properties": {
        "type": {
          "enum": ["deterministic", "model", "hybrid"]
        },
        "adapter": {
          "$ref": "#/$defs/namespaced_id"
        },
        "profile": {
          "$ref": "#/$defs/namespaced_id"
        }
      }
    },
    "capabilities": {
      "$ref": "#/$defs/action_list"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions"],
      "properties": {
        "allowed_actions": {
          "$ref": "#/$defs/action_list"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal", "relationship_beliefs", "runtime_storage"],
      "properties": {
        "personal": {
          "const": "private"
        },
        "relationship_beliefs": {
          "const": "private"
        },
        "runtime_storage": {
          "const": "external"
        }
      }
    }
  },
  "$defs": {
    "namespaced_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 160
    },
    "action_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespaced_id"
      }
    }
  }
}
